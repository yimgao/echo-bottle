rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App ID pattern for EchoBottle
    match /artifacts/{appId} {
      // Public bottle pool - anyone authenticated (including anonymous) can read/create
      match /public/data/pool_bottles/{bottleId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null 
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasAll(['content', 'type', 'createdAt', 'senderId']);
      }
      
      // User inbox - only the user can access their own inbox (includes anonymous users)
      match /users/{userId}/inbox/{bottleId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // User daily stats - only the user can access their own stats
      match /users/{userId}/daily_stats/{date} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // REMOVED: Guest paths (guests/{guestId}) - all users use Anonymous Auth now
    }
  }
}

