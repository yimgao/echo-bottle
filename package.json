{
  "name": "echobottle",
  "version": "1.0.0",
  "description": "A beautiful message-in-a-bottle web application",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:firebase": "FIREBASE_HOSTING=true next build",
    "start": "next start",
    "lint": "next lint",
    "firebase:deploy": "npm run build:firebase && firebase deploy --only hosting",
    "firebase:rules": "firebase deploy --only firestore:rules",
    "seed:bottles": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx scripts/seed-bottles.ts",
    "seed:cli": "NODE_TLS_REJECT_UNAUTHORIZED=0 node scripts/seed-bottles-cli.js",
    "add:bottles": "NODE_TLS_REJECT_UNAUTHORIZED=0 node scripts/add-bottles.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "firebase": "^10.7.1",
    "lucide-react": "^0.294.0",
    "next": "^14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "dotenv": "^16.3.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4",
    "firebase-admin": "^12.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
